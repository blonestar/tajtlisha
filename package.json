{
  "name": "tajtlisha",
  "version": "0.8.1",
  "description": "Linux-first desktop subtitle tool for short MP4 clips.",
  "private": true,
  "author": "Bojan",
  "license": "UNLICENSED",
  "homepage": "https://github.com/blonestar/tajtlisha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blonestar/tajtlisha.git"
  },
  "main": "out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:main:local && pnpm test:main:ai && pnpm test:renderer",
    "test:main:local": "vitest run --config tests/main/local/vitest.config.ts",
    "test:main:ai": "vitest run --config tests/main/ai/vitest.config.ts",
    "test:renderer": "vitest run --config tests/renderer/vitest.config.ts",
    "test:e2e": "env -u ELECTRON_RUN_AS_NODE playwright test",
    "lint": "tsc --noEmit",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs --platform all",
    "dist": "node scripts/fetch-ffmpeg.mjs --platform all && pnpm build && electron-builder --linux --win nsis --x64 --publish never",
    "dist:linux": "node scripts/fetch-ffmpeg.mjs --platform linux && pnpm build && electron-builder --linux --publish never",
    "dist:win": "node scripts/fetch-ffmpeg.mjs --platform win32 && pnpm build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "node scripts/fetch-ffmpeg.mjs --platform linux && pnpm build && electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.9",
    "i18next": "^25.6.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.3.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
